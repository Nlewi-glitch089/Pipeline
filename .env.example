POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb


# Replace the placeholder values with your real credentials locally (do NOT commit)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
# Example DATABASE_URL format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name
